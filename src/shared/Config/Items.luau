-- category: "resource" | "food" | "tool" | "weapon" | "armor" | "structure" | "special"
-- Ícones são emojis (zero assets externos, funcionam em todas as plataformas).

export type ItemDef = {
	id: string,
	name: string,
	description: string,
	category: string,
	icon: string,
	color: Color3,
	stack: number,
	-- ferramentas / armas
	toolType: string?, -- "axe" | "pickaxe" | "weapon" | "torch"
	tier: number?,
	damage: number?, -- dano em nós (ferramenta) ou criaturas (arma)
	cooldown: number?,
	range: number?,
	-- comida / bebida
	hunger: number?,
	thirst: number?,
	heal: number?,
	-- armadura
	defense: number?, -- redução de dano (0-1)
	warmth: number?, -- resistência ao frio (0-1)
	-- estrutura
	structure: string?, -- id em Structures quando o item é colocado no mundo
	rarity: string?, -- "common" | "uncommon" | "rare" | "epic" | "legendary"
}

