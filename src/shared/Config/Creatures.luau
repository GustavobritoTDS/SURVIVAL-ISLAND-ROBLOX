	health: number,
	damage: number,
	attackCooldown: number,
	attackRange: number,
	aggroRange: number,
	walkSpeed: number,
	runSpeed: number,
	regions: { string },
	nightOnly: boolean?,
	maxAlive: number, -- por servidor
